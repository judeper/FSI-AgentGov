{
  "_readme": [
    "Authoritative, base-controlled policy for the trusted-dependency-artifact gate.",
    "This file is only ever read from the protected default branch. A pull request that",
    "edits this file may not also change any guarded dependency path in the same pull",
    "request; the gate fails closed on that combination. Changing these values requires a",
    "separate CODEOWNERS-reviewed infrastructure pull request.",
    "Digests are raw-byte SHA-256 of the Git blob content, not of a normalized rendering.",
    "Activation is a base-relative exact tree delta: every approved base blob/absence, target mode,",
    "Git blob ID, raw-byte SHA-256, size, and the canonical patch digest are pinned."
  ],
  "policyVersion": 2,
  "checkName": "trusted-dependency-artifact",
  "defaultBranch": "main",

  "limits": {
    "maxChangedFiles": 750,
    "maxBlobBytes": 8388608,
    "maxTotalBlobBytes": 33554432,
    "maxTreeEntries": 20000,
    "maxTarEntries": 512,
    "maxTarEntryBytes": 4194304,
    "maxUnpackedBytes": 8388608,
    "maxDocumentBytes": 262144,
    "maxJsonBytes": 4194304,
    "maxMessages": 40,
    "maxMessageLength": 200
  },

