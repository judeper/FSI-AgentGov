{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "id": "headerSection",
      "style": "${SeverityStyle}",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "[ALERT] CA Policy Compliance — ${OverallStatus}",
                  "weight": "Bolder",
                  "size": "Large",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "Conditional Access Automation · ${CheckedAt}",
                  "spacing": "None",
                  "isSubtle": true,
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${OverallSeverityBadge}",
                  "weight": "Bolder",
                  "size": "ExtraLarge",
                  "color": "${SeverityColor}",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "runSummarySection",
      "items": [
        {
          "type": "TextBlock",
          "text": "Run Summary",
          "weight": "Bolder",
          "size": "Medium",
          "spacing": "Medium",
          "separator": true
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "FactSet",
                  "facts": [
                    {
                      "title": "Status",
                      "value": "${OverallStatus}"
                    },
                    {
                      "title": "Checked",
                      "value": "${CheckedAt}"
                    },
                    {
                      "title": "Total Policies",
                      "value": "${TotalPolicies}"
                    },
                    {
                      "title": "Compliance Rate",
                      "value": "${ComplianceRate}%"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "FactSet",
                  "facts": [
                    {
                      "title": "Passed",
                      "value": "${PassedCount}"
                    },
                    {
                      "title": "Failed",
                      "value": "${FailedCount}"
                    },
                    {
                      "title": "Drift Count",
                      "value": "${DriftCount}"
                    },
                    {
                      "title": "Overall Severity",
                      "value": "${OverallSeverity}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "zoneComplianceSection",
      "items": [
        {
          "type": "TextBlock",
          "text": "Zone Compliance",
          "weight": "Bolder",
          "size": "Medium",
          "spacing": "Medium",
          "separator": true
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone 1 — Personal Productivity",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${Zone1Passed} / ${Zone1Total}",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "WARNING",
                  "color": "Accent",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone 2 — Team Collaboration",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${Zone2Passed} / ${Zone2Total}",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "HIGH",
                  "color": "Warning",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Zone 3 — Enterprise Managed",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${Zone3Passed} / ${Zone3Total}",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "CRITICAL",
                  "color": "Attention",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "violationsSection",
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Violations (${ViolationCount})",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention",
          "spacing": "Medium",
          "separator": true
        },
        {
          "type": "Container",
          "id": "violationItem",
          "style": "Emphasis",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${ViolationType}",
                      "weight": "Bolder",
                      "color": "${ViolationSeverityColor}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${ViolationPolicyName}",
                      "weight": "Bolder",
                      "wrap": true
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "Zone ${ViolationZone}",
                      "weight": "Bolder",
                      "color": "${ViolationSeverityColor}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Expected",
                  "value": "${ViolationExpected}"
                },
                {
                  "title": "Actual",
                  "value": "${ViolationActual}"
                },
                {
                  "title": "Severity",
                  "value": "${ViolationSeverity}"
                },
                {
                  "title": "Regulatory",
                  "value": "${ViolationRegulatoryContext}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "driftSection",
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Drift Detection (${DriftCount})",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Warning",
          "spacing": "Medium",
          "separator": true
        },
        {
          "type": "Container",
          "id": "driftItem",
          "style": "Emphasis",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${DriftType}",
                      "weight": "Bolder",
                      "color": "Warning"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${DriftPolicyName}",
                      "weight": "Bolder",
                      "wrap": true
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "Zone ${DriftZone}",
                      "weight": "Bolder"
                    }
                  ]
                }
              ]
            },
            {
              "type": "FactSet",
              "facts": [
                {
                  "title": "Dimension",
                  "value": "${DriftDimension}"
                },
                {
                  "title": "Direction",
                  "value": "${DriftDirection}"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "View in Entra Portal",
      "url": "https://entra.microsoft.com/#view/Microsoft_AAD_ConditionalAccess/ConditionalAccessBlade/~/Policies",
      "iconUrl": "https://learn.microsoft.com/en-us/entra/identity/media/entra-id-icon.png"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Run Manual Check",
      "url": "https://portal.azure.com/#view/HubsExtension/BrowseResource/resourceType/Microsoft.Automation%2FAutomationAccounts"
    },
    {
      "type": "Action.OpenUrl",
      "title": "View Documentation",
      "url": "${DocsBaseUrl}/controls/pillar-1-security/1.11-conditional-access-and-phishing-resistant-mfa/"
    }
  ],
  "msteams": {
    "width": "Full"
  },
  "_metadata": {
    "templateName": "caa-compliance-alert",
    "templateVersion": "1.0.0",
    "solution": "Conditional Access Automation (CAA)",
    "description": "Teams adaptive card for CA policy compliance alerts with zone-based severity classification",
    "severityColorMapping": {
      "CRITICAL": "Attention",
      "HIGH": "Warning",
      "WARNING": "Accent",
      "Passed": "Good"
    },
    "severityStyleMapping": {
      "CRITICAL": "attention",
      "HIGH": "warning",
      "WARNING": "accent",
      "Passed": "good"
    },
    "templateVariables": {
      "scalar": [
        "OverallStatus",
        "OverallSeverity",
        "OverallSeverityBadge",
        "SeverityStyle",
        "SeverityColor",
        "CheckedAt",
        "TotalPolicies",
        "PassedCount",
        "FailedCount",
        "DriftCount",
        "ComplianceRate",
        "ViolationCount",
        "Zone1Passed",
        "Zone1Total",
        "Zone2Passed",
        "Zone2Total",
        "Zone3Passed",
        "Zone3Total",
        "DocsBaseUrl"
      ],
      "perViolation": [
        "ViolationType",
        "ViolationPolicyName",
        "ViolationZone",
        "ViolationExpected",
        "ViolationActual",
        "ViolationSeverity",
        "ViolationSeverityColor",
        "ViolationRegulatoryContext"
      ],
      "perDrift": [
        "DriftType",
        "DriftPolicyName",
        "DriftDimension",
        "DriftDirection",
        "DriftZone"
      ]
    },
    "flowIntegrationNotes": "The violationsSection and driftSection containers each contain a single template item (violationItem, driftItem). The Power Automate flow should: (1) Replace scalar variables via string substitution, (2) Build violation/drift card elements by iterating the runbook output arrays and replicating the item template per result, (3) Set violationsSection visibility based on ViolationCount > 0, (4) Set driftSection visibility based on DriftCount > 0."
  }
}
