              "target": "https://www.finra.org/rules-guidance/notices/09-20",
              "raw_row_digest": "sha256:049963286f83ed0a65c684b67f3fb57c39b4bc969e3c7085ccdd5269f1e59139",
              "listing_date": "2009-04-15"
